{
  "name": "mimir-widgets",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && tsc --noEmit -p functions && vite build",
    "preview": "vite preview",
    "pages:dev": "vite build --outDir dist && concurrently -n vite,wrangler -c blue,yellow \"vite build --outDir dist --watch\" \"wrangler pages dev dist --live-reload\""
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^10.0.4",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "mathjs": "^15.2.0",
    "qrcode": "^1.5.4"
  }
}
