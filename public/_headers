/color/*
  ! X-Frame-Options
/train
  ! X-Frame-Options
/train/*
  ! X-Frame-Options
/holidays
  ! X-Frame-Options
/holidays/*
  ! X-Frame-Options
/nearby
  ! X-Frame-Options
